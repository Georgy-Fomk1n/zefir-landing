# Если хостинг не позволяет указать корнем сайта папку public, этот файл направляет все запросы в неё.
# Файлы вне public (.env, vendor, app, storage) остаются недоступны из браузера.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Шаблон .env. На хостинге файл создаётся вручную один раз и деплоем не перезаписывается (docs/hosting.md).
APP_NAME="Зефир и пряник"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Хосты — в punycode
APP_URL=http://localhost:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=debug

# Локально — SQLite; staging/production — MySQL хостинга
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
# Очереди без постоянного процесса: cron запускает queue:work --stop-when-empty
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@xn-----mlchgbbqzthe9b5k.xn--p1ai"
MAIL_FROM_NAME="${APP_NAME}"

# ── Фронтенды и CORS (punycode!) ─────────────────────────────────
# production: https://xn-----mlchgbbqzthe9b5k.xn--p1ai,https://xn--80a9abv.xn-----mlchgbbqzthe9b5k.xn--p1ai
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
FRONTEND_URL=http://localhost:5173
STAFF_URL=http://localhost:5174
# Адрес для ссылок в письмах (кириллица, как canonical)
PUBLIC_SITE_URL=http://localhost:5173

SANCTUM_CUSTOMER_TTL=43200
SANCTUM_STAFF_TTL=720

# ── Магазин ([УТОЧНИТЬ] значения) ────────────────────────────────
ORDER_RESERVE_MINUTES=30
SLOT_PREP_MINUTES=120
SLOT_PICKUP_CAPACITY=6
SLOT_COURIER_CAPACITY=4
COURIER_OPENS=10:00
COURIER_CLOSES=21:00
LOYALTY_EARN_PERCENT=5
LOYALTY_MAX_SPEND_SHARE=0.3
LOYALTY_EXPIRE_DAYS=365
SUBSCRIPTION_GRACE_DAYS=3
COURIER_PHONE_POLICY=active_only
CASH_ON_DELIVERY=false
COURIER_AUTO_ASSIGN=false

# ── Оплата: fake | tochka ────────────────────────────────────────
PAYMENT_PROVIDER=fake
TOCHKA_BASE_URL=https://enter.tochka.com/uapi
TOCHKA_JWT=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_WEBHOOK_PUBLIC_KEY=
TOCHKA_RECURRING=false
FISCALIZATION=none

# ── Доставка и геоподсказки ──────────────────────────────────────
GEO_PROVIDER=null
DADATA_TOKEN=
YANDEX_GEOSUGGEST_KEY=
CDEK_ENABLED=false
CDEK_CLIENT_ID=
CDEK_SECRET=
RUSSIAN_POST_ENABLED=false
RUSSIAN_POST_TOKEN=

# ── Уведомления: mail,telegram,sms ───────────────────────────────
NOTIFY_CHANNELS=mail
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER=log

# ── Пересборка статики и IndexNow ────────────────────────────────
REBUILD_ENABLED=false
GITHUB_REPOSITORY=georgy-fomk1n/zefir-landing
GITHUB_DISPATCH_TOKEN=
INDEXNOW_ENABLED=false
INDEXNOW_KEY=

# ── Пост-деплой хук ──────────────────────────────────────────────
DEPLOY_HOOK_ENABLED=false
DEPLOY_HOOK_TOKEN=
DEPLOY_HOOK_IPS=
# Одноразово для первого запуска (хук создаст администратора, если админов нет). Удалить после входа.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

{
  "name": "@zefir/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "catalog": "node scripts/fetch-catalog.mjs",
    "media": "node scripts/media.mjs",
    "build": "node scripts/fetch-catalog.mjs && vite-react-ssg build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seo:check": "node scripts/seo-check.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.11",
    "@zefir/shared": "0.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.1",
    "react-router-dom": "^6.30.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "beasties": "^0.1.0",
    "jsdom": "^27.2.0",
    "node-html-parser": "^7.0.1",
    "vite": "^7.2.4",
    "vite-react-ssg": "^0.9.2",
    "vitest": "^4.0.14"
  }
}
